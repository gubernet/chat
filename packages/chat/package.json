{
	"name": "@gubernet/chat",
	"version": "0.2.0",
	"description": "React components for chatting with AI agents built on Gubernet",
	"keywords": [
		"agent",
		"ai",
		"chat",
		"gubernet",
		"react"
	],
	"homepage": "https://gubernet.ai",
	"bugs": {
		"url": "https://github.com/gubernet/chat/issues"
	},
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gubernet/chat.git",
		"directory": "packages/chat"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"default": "./dist/index.js"
		},
		"./contract": {
			"types": "./dist/types/contract/index.d.ts",
			"default": "./dist/contract/index.js"
		},
		"./styles.css": "./dist/styles.css",
		"./vendor.css": "./dist/vendor.css",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rm -rf dist && tsup && tsc -p tsconfig.build.json && node scripts/build-css.mjs",
		"clean": "rm -rf dist",
		"prepublishOnly": "pnpm build",
		"test": "vitest run",
		"test:watch": "vitest",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"@assistant-ui/react": "0.15.32",
		"@assistant-ui/react-markdown": "0.14.24",
		"@assistant-ui/react-streamdown": "0.3.21",
		"@base-ui/react": "^1.9.0",
		"@streamdown/code": "1.1.1",
		"@streamdown/math": "1.0.3",
		"@streamdown/mermaid": "1.0.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"katex": "^0.18.2",
		"lucide-react": "^1.65.0",
		"papaparse": "5.7.0",
		"pdfjs-dist": "6.3.289",
		"react-pdf": "11.0.0",
		"read-excel-file": "9.3.14",
		"remark-gfm": "4.0.1",
		"streamdown": "2.7.1",
		"tailwind-merge": "^3.7.0",
		"use-intl": "^4.14.9",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "26.6.6",
		"@types/papaparse": "5.5.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"postcss": "8.5.32",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"tailwindcss": "4.3.3",
		"tsup": "^9.0.0",
		"typescript": "7.0.2",
		"vitest": "^5.0.5"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	}
}
