{
	"name": "@layeral/chat-vue",
	"version": "0.8.0",
	"description": "The chat of Layeral agents as a Vue component",
	"keywords": [
		"agent",
		"ai",
		"chat",
		"layeral",
		"vue"
	],
	"homepage": "https://layeral.com",
	"bugs": {
		"url": "https://github.com/layeral/chat/issues"
	},
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/layeral/chat.git",
		"directory": "packages/chat-vue"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"default": "./dist/index.js"
		},
		"./styles.css": "./dist/styles.css",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rm -rf dist && tsup && tsc -p tsconfig.build.json && node scripts/copy-styles.mjs",
		"clean": "rm -rf dist",
		"prepublishOnly": "pnpm build",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"@layeral/chat-element": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "26.6.6",
		"tsup": "^9.0.0",
		"typescript": "7.0.2",
		"vue": "3.5.45"
	},
	"peerDependencies": {
		"vue": "^3.3.0"
	}
}
